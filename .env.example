# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string. On Replit this is set automatically when you
# add a database (Database tool) — don't add it to Secrets yourself there.
DATABASE_URL="postgresql://user:password@localhost:5432/crm"

# File storage: "replit" (Object Storage, automatic on Replit) or "local" (./storage folder)
# STORAGE_DRIVER="local"

# Long random string used to sign login session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-string"

# Public address of this app, used in the tracked links emailed to clients
# (e.g. https://crm.yourcompany.com). If empty, it's taken from the request.
APP_URL=""

# Secret for the daily digest endpoint: /api/cron/daily?secret=...
CRON_SECRET="change-me-too"

# Secret for the booking webhook (Calendly, Cal.com, Zapier):
# /api/webhooks/booking?secret=...
BOOKING_WEBHOOK_SECRET="change-me-three"

# Optional: fallback SMTP settings if you haven't filled them in under
# Console > Settings. You can leave these blank.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AURELIA DISTRIBUCIJA d.o.o. <no-reply@example.com>"

# Used by `npm run db:seed` to create the first admin and settings.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_COMPANY_NAME="AURELIA DISTRIBUCIJA d.o.o."
# Set to "false" to skip creating the starter catalog (Unbusyness editions + Arrive).
SEED_DEMO_CATALOG="true"
