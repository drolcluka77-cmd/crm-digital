// Digital Products Distribution CRM — database schema
//
// PostgreSQL. On Replit, add a database with the "Database" tool and
// DATABASE_URL is set automatically (also for published deployments).
//
// Note: "enum-like" fields (role, status, billing, type …) are plain
// strings; the allowed values live in lib/constants.ts and are validated
// in the server actions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── People ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SALES") // ADMIN | MANAGER | SALES
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // A seller can belong to a manager's team. Managers only see and
  // control the sellers on their own team; admins see everyone.
  managerId String?
  manager   User?   @relation("Team", fields: [managerId], references: [id], onDelete: SetNull)
  team      User[]  @relation("Team")

  // Seller's own booking page (Calendly, Cal.com, Google booking …).
  bookingUrl         String?
  // Overrides the product commission % on this seller's new quote lines.
  commissionRate     Float?
  emailNotifications Boolean @default(true)

  productAccess  ProductAccess[]    @relation("AccessUser")
  accessGranted  ProductAccess[]    @relation("AccessGrantedBy")
  customers      Customer[]         @relation("CustomerOwner")
  quotes         Quote[]            @relation("QuoteSeller")
  approvedQuotes Quote[]            @relation("QuoteApprover")
  contracts         Contract[]     @relation("ContractSeller")
  workLogs          WorkLog[]      @relation("WorkLogUser")
  approvedWorkLogs  WorkLog[]      @relation("WorkLogApprover")
  reviewedContracts Contract[]     @relation("ContractReviewer")
  activities     Activity[]
  shares         MaterialShare[]
  notifications  Notification[]
  payouts        CommissionPayout[] @relation("PayoutSeller")
  payoutsMade    CommissionPayout[] @relation("PayoutCreatedBy")
  certifications Certification[]
  subscriptions  Subscription[]
  leadPools      LeadPool[]

  // Lead finder: how many recommended leads this seller gets per day
  // (null = the company default in Settings).
  prospectQuota        Int?
  // Products this seller wants recommended leads for (comma-separated ids; null = all they may sell).
  prospectProducts     String?
  locale               String   @default("sl") // CRM language for sellers: "sl" or "en"
  prospectSegments     String? // JSON { leadGroupKey: ["Frizerski saloni", …] } — industries the seller wants leads for
  prospectsRecommended Prospect[] @relation("ProspectRecommended")
  prospectsClaimed     Prospect[] @relation("ProspectClaimed")
  candidatesHired      Candidate[] @relation("CandidateHiredAs")

  // UGC creator programme (seller switches it on and accepts the terms).
  ugcCreator      Boolean    @default(false)
  ugcTermsAt      DateTime?
  ugcCode         String? // e.g. "ANA" — link /r/ana and the customer code (unique, enforced in lib/ugc.ts)
  ugcVideos       UgcVideo[] @relation("UgcCreator")
  ugcReviewed     UgcVideo[] @relation("UgcReviewer")
  ugcTasksCreated UgcTask[]  @relation("UgcTaskAuthor")
  ugcLeads        Customer[] @relation("UgcCreatorLeads")
  ugcClicks       UgcClick[]
  payments         Payment[] @relation("PaymentSeller")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  geoClientsSold     GeoClient[] @relation("GeoSeller")
  geoClientsAssigned GeoClient[] @relation("GeoAssistant")
  geoClientsAds      GeoClient[] @relation("GeoAdsAssistant")
  geoTasks           GeoTask[]   @relation("GeoTaskAssignee")
}

// ─── Catalog ─────────────────────────────────────────────────────────────

// One sellable product or product edition, e.g. "Unbusyness for Building
// Managers". Editions of the same product share a `family` ("Unbusyness"),
// which is how the catalog groups them.
model Product {
  id             String   @id @default(cuid())
  name           String
  family         String?
  // Products with the same lead group share Lead finder leads (e.g. the three
  // Picked packages). null = the product has its own leads.
  leadGroup      String?
  tagline        String?
  targetSegment  String? // who it's for: "Property managers, HOAs"
  description    String?
  pitch          String? // 30-second elevator pitch for sellers
  keyBenefits    String? // one per line
  idealCustomer  String? // qualification: who is a good fit, questions to ask
  objections     String? // "Objection — answer", one block per line
  websiteUrl     String?
  demoUrl        String? // live demo / sandbox / booking link
  imageUrl       String?
  color          String? // accent colour for cards, e.g. #4f46e5
  commissionRate Float    @default(0) // % of first-year net value
  // % of the yearly value paid to the seller each time a subscription renews.
  renewalCommissionRate Float   @default(0)
  // Highest total discount (%) off list price a seller may give without
  // manager approval. null = use the company default in Settings.
  maxDiscount           Float?
  // Sellers must pass this product's quiz before they can quote or send it.
  requireCertification  Boolean @default(false)
  passScore             Int     @default(80) // % correct needed to pass
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plans      ProductPlan[]
  materials  SalesMaterial[]
  access     ProductAccess[]
  quoteItems     QuoteItem[]
  interests      CustomerProduct[]
  templates      EmailTemplate[]
  questions      QuizQuestion[]
  certifications Certification[]
  prospectRules  ProspectRule[]
  prospects      Prospect[]
  ugcTasks       UgcTask[]
  ugcVideos      UgcVideo[]
}

// Price points for a product: "Starter €29 / month per building".
model ProductPlan {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  billing     String   @default("MONTHLY") // ONE_TIME | MONTHLY | YEARLY
  unitLabel   String? // "per building", "per user", "per bed"
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  quoteItems QuoteItem[]
}

// Which seller may see & sell which product. No row = no access.
model ProductAccess {
  userId      String
  user        User     @relation("AccessUser", fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   User?    @relation("AccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime @default(now())

  @@id([userId, productId])
}

// Sales enablement: decks, one-pagers, demo videos, scripts …
// productId = null means "general" (visible to every seller).
model SalesMaterial {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String   @default("OTHER") // see MATERIAL_TYPES
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath  String? // private file on disk (storage/…), served via /api/materials/[id]
  fileName     String?
  fileType     String?
  fileSize     Int?
  linkUrl      String? // external link (YouTube, Loom, Google Slides, live demo)
  internalOnly Boolean  @default(false) // true = for sellers only, can't be sent to clients
  sortOrder    Int      @default(0)
  uploadedAt   DateTime @default(now())

  shares MaterialShare[]
}

// A tracked link a seller sent to a client (/s/<token>). Lets the seller
// see whether — and how often — the client opened the material.
model MaterialShare {
  id            String        @id @default(cuid())
  token         String        @unique
  materialId    String
  material      SalesMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  views         Int           @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
}

// ─── CRM ─────────────────────────────────────────────────────────────────

model Customer {
  id             String    @id @default(cuid())
  name           String // contact person
  jobTitle       String?
  company        String?
  segment        String? // Building management, Trades, Hotel, Hospital …
  email          String? // stored lower-case (used for duplicate-lead checks)
  phone          String?
  website        String?
  city           String?
  country        String?
  size           String? // "120 apartments", "4 buildings", "300 beds"
  source         String? // Referral, Cold call, LinkedIn …
  note           String?
  status         String    @default("NEW") // see LEAD_STATUSES
  estimatedValue Float? // expected first-year value, EUR excl. VAT
  nextFollowUpAt DateTime?
  lastContactAt  DateTime?
  demoAt         DateTime? // next scheduled demo
  bookingToken   String?   @unique // tracked booking link /b/<token>
  // null owner = unassigned lead sitting in a lead pool
  ownerId        String?
  owner          User?     @relation("CustomerOwner", fields: [ownerId], references: [id])
  poolId         String?
  pool           LeadPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Where the lead came from: COLD (lead finder / imported list) | WARM_WEB (signed up
  // on the website) | WARM_UGC (via a UGC creator's link or code) | OWN (found by the
  // seller — higher commission) | OTHER. See LEAD_TYPE_LABEL.
  leadType       String    @default("OTHER")
  ugcCreatorId   String?
  ugcCreator     User?     @relation("UgcCreatorLeads", fields: [ugcCreatorId], references: [id], onDelete: SetNull)
  refCode        String? // creator code the lead came with (link or typed code)
  freeMonth      Boolean   @default(false) // used a creator code: first month free
  // Warm leads go to one seller at a time; if not accepted in time they move on.
  warmAssignedAt DateTime?
  warmAcceptedAt DateTime?
  warmSkippedBy  String? // comma-separated ids of sellers it already passed through

  payments   Payment[]
  quotes     Quote[]
  contracts  Contract[]
  activities Activity[]
  interests     CustomerProduct[]
  shares        MaterialShare[]
  subscriptions Subscription[]
  geoClients    GeoClient[]
}

// Which products a lead is interested in.
model CustomerProduct {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
}

// Timeline entry on a customer: calls, meetings, demos, emails, and
// automatic events (quote sent, material opened …).
model Activity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String // see ACTIVITY_TYPES
  body       String?
  createdAt  DateTime @default(now())
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  userId     String
  user       User        @relation("QuoteSeller", fields: [userId], references: [id])
  status     String      @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED
  items      QuoteItem[]
  discount   Float       @default(0)
  vatRate    Float       @default(22)
  notes      String?
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sentAt     DateTime?
  decidedAt  DateTime?

  // Online acceptance (/q/<publicToken>)
  publicToken     String?   @unique
  viewedAt        DateTime?
  acceptedByName  String?
  acceptedByTitle String?
  acceptedIp      String?
  declineReason   String?

  // Price guardrails: NONE | PENDING | APPROVED | REJECTED
  approvalStatus      String    @default("NONE")
  approvalReason      String? // why approval is needed
  approvalNote        String? // manager's comment
  approvalRequestedAt DateTime?
  approvedById        String?
  approvedBy          User?     @relation("QuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?

  subscription Subscription?
  payments     Payment[]
  contract     Contract?
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteId        String
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  planId         String?
  plan           ProductPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  name           String
  quantity       Int          @default(1)
  unitPrice      Float
  billing        String       @default("ONE_TIME") // ONE_TIME | MONTHLY | YEARLY
  unitLabel      String?
  // Snapshot of the product's commission % when the line was added, so
  // later rate changes don't rewrite history.
  commissionRate        Float   @default(0)
  renewalCommissionRate Float   @default(0)
  listPrice             Float? // the plan's price when added (for discount checks)
}

// Single-row table (id = 1): company info, defaults and SMTP settings.
model Settings {
  id                Int     @id @default(1)
  companyName       String  @default("AURELIA DISTRIBUCIJA d.o.o.")
  companyAddress    String?
  companyEmail      String?
  companyPhone      String?
  vatRate           Float   @default(22)
  quoteValidityDays Int     @default(30)
  // Default max discount (%) without approval; null = no limit.
  defaultMaxDiscount Float?
  // Monthly bonus tiers: "10000:2, 25000:4" = +2 % of the month's won value
  // once a seller wins ≥ €10,000 in a month, +4 % from €25,000.
  commissionTiers    String?
  renewalTermMonths  Int     @default(12)
  logoUrl           String?
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPass          String?
  smtpFrom          String?

  // Lead finder
  prospectDailyPerSeller  Int       @default(5)   // new recommended leads per seller per day
  prospectExpiryDays      Int       @default(3)   // unclaimed recommendations go back after N days
  prospectLookupDailyCap  Int       @default(100) // contact look-ups (Google/AI) per day, company-wide
  prospectAutoImport      Boolean   @default(false)
  prospectLastImportAt    DateTime?
  prospectLastImportNote  String?
  prospectRulesVersion    Int       @default(1) // starter-rule upgrades already applied

  // Contracts & proforma invoices — the company that signs and bills.
  legalName            String  @default("AURELIA GROUP d.o.o.")
  legalAddress         String?
  legalRegNo           String? // matična številka
  legalTaxNo           String? // davčna številka
  legalVatId           String? // ID za DDV (only for VAT payers)
  legalVatPayer        Boolean @default(false) // false: no VAT on contracts/proformas (94. člen ZDDV-1)
  legalIban            String?
  legalBic             String?
  legalBank            String?
  legalRepresentative  String? // who signs for the company, e.g. "Luka Drolc, direktor"
  legalEmail           String?
  contractTemplate     String? // null = the built-in template
  contractTemplatePicked String? // Mr. Picked packages; null = the built-in Mr. Picked template
  contractReviewRequired Boolean @default(true) // a manager/admin approves before it goes out
  proformaDueDays      Int     @default(8)
  revolutWebhookId     String?
  revolutWebhookSecret String? // signing secret for /api/webhooks/revolut

  // Recruiting
  recruitingCalendlyUrl     String?  @default("https://calendly.com/drolcluka77/30min")
  recruitingAutoInvite      Boolean  @default(true)
  recruitingAutoReminder    Boolean  @default(false) // one reminder 3 days after the invitation
  recruitingInviteSubject   String?
  recruitingInviteBody      String?
  recruitingRetentionMonths Int      @default(6)

  // Commission on paid amounts
  ownLeadCommissionRate Float  @default(20) // % on leads the seller found themselves
  commissionMonths      Int    @default(12) // commission only on payments in the first N months

  // Warm leads (website / UGC): hours a seller has to accept before it moves on
  warmClaimHours Int    @default(72)
  websiteUrl     String @default("https://unbusyness.com")

  // UGC creators
  ugcVideoPay   Float   @default(5)
  ugcBonusTiers String? @default("10000:10, 40000:25, 100000:50") // views:bonus €
  ugcTerms      String?
}

// ─── Commission ──────────────────────────────────────────────────────────

// A payment made to a seller for a statement period ("2026-11").
model CommissionPayout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("PayoutSeller", fields: [userId], references: [id], onDelete: Cascade)
  period      String // YYYY-MM
  amount      Float
  note        String?
  paidAt      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

// ─── Recurring revenue ───────────────────────────────────────────────────

// Created when a quote with monthly/yearly lines is accepted.
model Subscription {
  id                String    @id @default(cuid())
  quoteId           String    @unique
  quote             Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String? // seller credited with renewals
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            String    @default("ACTIVE") // ACTIVE | CANCELLED
  startDate         DateTime
  renewalDate       DateTime
  termMonths        Int       @default(12)
  monthlyValue      Float // net recurring value per month (MRR)
  annualValue       Float // net recurring value per term year
  renewalCommission Float     @default(0) // paid on each renewal
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime  @default(now())

  renewals SubscriptionRenewal[]
}

model SubscriptionRenewal {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String? // seller credited
  renewedAt      DateTime     @default(now())
  annualValue    Float
  commission     Float
}

// ─── Templates, pools, training, notifications ──────────────────────────

// Ready-made emails. productId null = general (all sellers).
// Placeholders: {{firstName}} {{name}} {{company}} {{product}}
// {{sellerName}} {{sellerPhone}} {{bookingLink}} {{demoLink}}
model EmailTemplate {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  purpose   String   @default("OTHER") // FIRST_CONTACT | FOLLOW_UP | AFTER_DEMO | PROPOSAL | OTHER
  subject   String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// A list of unassigned leads. managerId null = company-wide pool (admin).
model LeadPool {
  id          String     @id @default(cuid())
  name        String
  description String?
  managerId   String?
  manager     User?      @relation(fields: [managerId], references: [id], onDelete: SetNull)
  claimable   Boolean    @default(false) // sellers may claim leads themselves
  claimLimit  Int? // max open claimed leads per seller from this pool
  createdAt   DateTime   @default(now())
  leads       Customer[]
}

model QuizQuestion {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question     String
  options      String // JSON array of answer strings
  correctIndex Int
  explanation  String?
  sortOrder    Int     @default(0)
}

model Certification {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bestScore Int       @default(0)
  lastScore Int       @default(0)
  attempts  Int       @default(0)
  passedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@id([userId, productId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Lead finder ─────────────────────────────────────────────────────────

// Keywords in a company's registered name that point to a product,
// e.g. "hotel, penzion, garni" → Unbusyness for Hotels.
model ProspectRule {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  segment   String? // industry label shown to sellers, e.g. "Frizerski saloni"
  keywords  String // comma-separated; matched against the start of words in the name
  exclude   String? // comma-separated words that disqualify a match
  priority  Int      @default(0) // higher wins when several products match
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A company found in a public register, waiting to be recommended to a
// seller. Claiming it creates a normal Customer owned by the seller.
model Prospect {
  id              String    @id @default(cuid())
  // Lead key: the matična številka, plus ":<pool>" for leads in a shared
  // pool (e.g. "1234567000:Picked"), so one company can be a lead for
  // Picked and for an Unbusyness product at the same time.
  regNumber       String    @unique
  companyReg      String? // matična številka alone
  pool            String    @default("main") // "main", or a product leadGroup
  name            String
  legalForm       String?
  soleTrader      Boolean   @default(false) // s.p. = natural person (no marketing email without consent)
  street          String?
  postalCode      String?
  postTown        String?
  settlement      String?
  source          String    @default("AJPES")
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  matchedKeyword  String?
  segment         String? // industry, from the matching rule
  score           Int       @default(0)
  status          String    @default("NEW") // NEW | RECOMMENDED | CLAIMED | REJECTED | DO_NOT_CONTACT
  recommendedToId String?
  recommendedTo   User?     @relation("ProspectRecommended", fields: [recommendedToId], references: [id], onDelete: SetNull)
  recommendedAt   DateTime?
  skippedBy       String? // ids of sellers who passed on it, so it goes to someone else
  claimedById     String?
  claimedBy       User?     @relation("ProspectClaimed", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt       DateTime?
  customerId      String?
  rejectReason    String?
  // Contact look-up results (suggestions with sources)
  phone           String?
  email           String?
  website         String?
  activity        String?
  lookup          String? // JSON: details and sources
  lookedUpAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, productId])
  @@index([companyReg])
  @@index([recommendedToId, status])
}

// ─── Recruiting ──────────────────────────────────────────────────────────

// Someone who applied to sell for us (public form /prijava).
model Candidate {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique // lower-case
  phone         String?
  city          String?
  status        String? // student / dijak / other
  hoursPerWeek  String?
  availableFrom String?
  workMode      String? // remote / Ljubljana / both
  languages     String?
  experience    String?
  motivation    String?
  answers       Json? // extra questions of the position: [{ key, label, value }]
  cvKey         String? // private storage key
  cvName        String?
  source        String? // e.g. "Študentski servis" (?vir= on the form link)
  position      String    @default("sales") // see RECRUITING_POSITIONS (?pozicija= on the form link)
  consentAt     DateTime
  consentIp     String?
  stage         String    @default("NEW") // NEW | INVITED | BOOKED | INTERVIEWED | ONBOARDING | HIRED | REJECTED
  token         String    @unique // tracked Calendly link /prijava/termin/<token>
  invitedAt     DateTime?
  reminderAt    DateTime?
  clickedAt     DateTime?
  bookedAt      DateTime? // meeting time from the booking webhook
  rating        Int? // 1–5
  notes         String?
  hiredUserId   String?
  hiredUser     User?     @relation("CandidateHiredAs", fields: [hiredUserId], references: [id], onDelete: SetNull)
  closedAt      DateTime? // hired or rejected — starts the retention clock
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([stage])
}

// ─── Payments (commission is paid on money actually received) ───────────

// A customer payment against an accepted quote. Commission = amount × rate,
// only within the first Settings.commissionMonths after acceptance.
model Payment {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId       String? // seller credited
  user         User?    @relation("PaymentSeller", fields: [userId], references: [id], onDelete: SetNull)
  amount       Float // net, excl. VAT
  paidAt       DateTime
  rate         Float    @default(0) // commission % applied
  commission   Float    @default(0)
  note         String?
  source       String   @default("MANUAL") // MANUAL | IMPORT
  createdById  String?
  createdBy    User?    @relation("PaymentRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId, paidAt])
}

// ─── UGC creators ────────────────────────────────────────────────────────

// A video idea for creators, written by the sales manager (or suggested by AI).
model UgcTask {
  id          String     @id @default(cuid())
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  title       String
  brief       String? // what to show, hook, call to action
  theme       String? // e.g. "Christmas", "news: ..."
  weekOf      DateTime? // Monday of the week it was planned for
  status      String     @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  ai          Boolean    @default(false)
  createdById String?
  createdBy   User?      @relation("UgcTaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  videos      UgcVideo[]

  @@index([status])
}

model UgcVideo {
  id           String    @id @default(cuid())
  creatorId    String
  creator      User      @relation("UgcCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  taskId       String?
  task         UgcTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  title        String
  note         String? // creator's note to the reviewer
  fileKey      String? // private storage key (uploaded video)
  fileName     String?
  fileType     String?
  fileSize     Int?
  linkUrl      String? // or a link (Google Drive, Dropbox, WeTransfer …)
  status       String    @default("SUBMITTED") // SUBMITTED | CHANGES | APPROVED | REJECTED | PUBLISHED
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?     @relation("UgcReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  postUrl      String? // the Instagram / TikTok post
  publishedAt  DateTime?
  basePay      Float     @default(0) // set when published (Settings.ugcVideoPay)
  views        Int?
  viewsAt      DateTime? // when the manager entered the views
  bonus        Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([creatorId, status])
  @@index([status])
}

// A click on a creator's link (/r/<code>/<page>).
model UgcClick {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  page      String?
  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
}

// ─── Contracts (from a quote → review → e-signature → proforma invoice) ──

model Contract {
  id           String    @id @default(cuid())
  number       String    @unique // POG-2026-0001
  quoteId      String    @unique
  quote        Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId       String // seller
  user         User      @relation("ContractSeller", fields: [userId], references: [id])
  status       String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | SENT | SIGNED | CANCELLED

  // Client details as they appear on the contract
  clientCompany        String?
  clientAddress        String?
  clientRegNo          String?
  clientVatId          String?
  clientRepresentative String? // who signs for the client
  clientEmail          String? // where the signing link and code go

  title        String    @default("Pogodba o naročilu storitev")
  body         String // full contract text (editable until sent)

  // Review
  reviewRequestedAt DateTime?
  reviewedById      String?
  reviewedBy        User?     @relation("ContractReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?

  // Sending & signing (/c/<publicToken>)
  publicToken     String?   @unique
  sentAt          DateTime?
  viewedAt        DateTime?
  codeHash        String? // e-mail code for signing (hashed)
  codeExpiresAt   DateTime?
  codeAttempts    Int       @default(0)
  signedName      String?
  signedTitle     String?
  signedEmail     String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  documentHash    String? // SHA-256 of the signed text

  // Proforma invoice (predračun) issued after signing
  proformaNumber   String?   @unique
  proformaIssuedAt DateTime?
  proformaDueAt    DateTime?
  paymentReference String? // SI00 …
  paymentLinkUrl   String? // card payment link (Revolut checkout)
  revolutOrderId   String?
  paidAt           DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([revolutOrderId])
}

// ─── Timesheet: hours and work done per day (hourly-paid sellers) ─────

model WorkLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("WorkLogUser", fields: [userId], references: [id], onDelete: Cascade)
  day            String // YYYY-MM-DD (Ljubljana time)
  startTime      String // HH:MM
  endTime        String // HH:MM
  breakMinutes   Int       @default(0)
  minutes        Int // worked minutes (end − start − break)
  calls          Int       @default(0) // reported by the seller
  conversations  Int       @default(0) // calls where they reached the decision maker
  meetings       Int       @default(0) // meetings booked
  emails         Int       @default(0)
  notes          String // what was done
  approvedById   String?
  approvedBy     User?     @relation("WorkLogApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  managerNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, day])
}


// ─── GEO delivery (Mr. Picked): handover from seller, company card, accesses, tasks ──

// One per signed customer. Created by the seller's handover form; worked by the GEO assistant.
model GeoClient {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  line           String    @default("PICKED") // PICKED (GEO assistant) | UNBUSYNESS (forward deployment engineer, pilots)
  details        Json      @default("{}") // line-specific handover fields (Unbusyness: units, channels, pilot goal …)
  contractId     String?
  sellerId       String?
  seller         User?     @relation("GeoSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  assistantId    String?
  assistant      User?     @relation("GeoAssistant", fields: [assistantId], references: [id], onDelete: SetNull)
  adsAssistantId String? // Lead Engine add-on: works the Google Ads / landing page / e-mail tasks
  adsAssistant   User?     @relation("GeoAdsAssistant", fields: [adsAssistantId], references: [id], onDelete: SetNull)
  // DRAFT | HANDED_OVER | KICKOFF | ACCESS | BASELINE | FIX | MAINTENANCE | DAY90 | CANCELLED (see lib/geo.ts)
  status         String    @default("DRAFT")
  statusAt       DateTime  @default(now())

  // Handover form (seller)
  company        String
  industry       String? // see GEO_INDUSTRIES
  package        String? // VISIBLE | RECOMMENDED | CONCIERGE
  addons         Json      @default("[]") // ["VIDEOS","REVIEWS","WHATSAPP","WEBSITE"]
  monthlyPrice   Float?
  setupFee       Float?
  startDate      DateTime?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  webManager     String? // who runs the website
  customerValue  Float? // value of one new customer (€)
  mainProblem    String?
  languages      Json      @default("[]") // ["SL","EN",…]
  promised       String?
  specialNotes   String?
  handedOverAt   DateTime?
  approvedAt     DateTime?

  // Company card (assistant) — the single source the code and listings are built from
  card           Json      @default("{}")
  cardUpdatedAt  DateTime?
  cardUpdatedBy  String?

  day90DoneAt    DateTime?
  freeMonth4     Boolean   @default(false)
  cancelledAt    DateTime?
  endsAt         DateTime? // last day of the 60-day notice
  lastCheck      Json? // last website verification result

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accesses     GeoAccess[]
  tasks        GeoTask[]
  measurements GeoMeasurement[]
  offers       ImportOffer[]
  logs         GeoLog[]

  @@index([status])
  @@index([assistantId])
  @@index([customerId])
}

model GeoAccess {
  id        String    @id @default(cuid())
  clientId  String
  client    GeoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform  String // see GEO_PLATFORMS
  status    String    @default("NOT_REQUESTED") // NOT_REQUESTED | REQUESTED | APPROVED | PROBLEM
  method    String? // e.g. "manager on info@mrpicked.eu"
  note      String?
  updatedAt DateTime  @updatedAt

  @@index([clientId])
}

// Admin-editable task templates per package / add-on.
model GeoTaskTemplate {
  id            String   @id @default(cuid())
  key           String? // code hooks, e.g. "website-code", "kickoff-card", "baseline"
  packages      Json     @default("[]") // ["VISIBLE","RECOMMENDED","CONCIERGE","ADDON_VIDEOS",…]
  title         String
  description   String? // checklist, one step per line
  phase         String   @default("START") // START | FIX | MONTHLY | QUARTERLY | DAY90
  recurrence    String   @default("ONCE") // ONCE | MONTHLY | QUARTERLY
  dueDay        Int      @default(7) // ONCE: days after start; MONTHLY/QUARTERLY: day of month (0 = last day)
  needsApproval Boolean  @default(false)
  technical     Boolean  @default(false)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model GeoTask {
  id            String    @id @default(cuid())
  clientId      String
  client        GeoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId    String?
  key           String?
  period        String? // "2026-12" for monthly tasks (dedupe)
  title         String
  description   String?
  phase         String    @default("START")
  dueDate       DateTime?
  assigneeId    String?
  assignee      User?     @relation("GeoTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  needsApproval Boolean   @default(false)
  technical     Boolean   @default(false)
  // OPEN | IN_PROGRESS | WAITING_CLIENT | WAITING_APPROVAL | DONE | NOT_POSSIBLE
  status        String    @default("OPEN")
  note          String?
  waitingSince  DateTime?
  remindedAt    DateTime?
  doneAt        DateTime?
  approvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([assigneeId, status])
  @@index([clientId, templateId, period])
}

model GeoMeasurement {
  id          String    @id @default(cuid())
  clientId    String
  client      GeoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month       Int // 0 = baseline
  measuredAt  DateTime  @default(now())
  answers     Int?
  mentions    Int?
  score       Float? // % of AI answers that mention the business
  mapRanks    Json      @default("[]") // [{ query, rank }]
  wrongFacts  Json      @default("[]") // ["Old opening hours on Bing", …]
  reportUrl   String?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

// SimpleImport: a supplier offer gathered by the import coordinator (≥ 3 compared per client).
model ImportOffer {
  id           String    @id @default(cuid())
  clientId     String
  client       GeoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplier     String // internal name; shown to the client only after the commission is paid
  location     String? // city / province
  contact      String? // person, e-mail, WeChat, Alibaba link
  unitPrice    Float?
  currency     String    @default("USD")
  moq          Int?
  leadDays     Int? // production time in days
  incoterm     String?
  certificates String?
  sampleCost   Float?
  verified     Boolean   @default(false) // licence / factory checked
  status       String    @default("CANDIDATE") // CANDIDATE | SHORTLIST | SAMPLES | CHOSEN | REJECTED
  note         String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
}

// Who changed what (card, status, tasks).
model GeoLog {
  id        String    @id @default(cuid())
  clientId  String
  client    GeoClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  detail    String?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

// AI Mirror: what ChatGPT and Gemini answer about a business (QUICK during a call, FULL before a meeting / as a measurement).
model AiMirrorRun {
  id           String   @id @default(cuid())
  kind         String // QUICK | FULL
  status       String   @default("RUNNING") // RUNNING | DONE | FAILED
  company      String
  city         String
  category     String
  website      String?
  phone        String?
  address      String?
  queries      Json     @default("[]") // [{ q, kind }]
  answers      Json     @default("[]") // MirrorAnswer[]
  summary      Json     @default("{}") // MirrorSummary
  mentions     Int?
  answersCount Int?
  score        Float? // % of discovery answers that mention the business
  costEur      Float    @default(0)
  error        String?
  customerId   String?
  geoClientId  String?
  measurementId String?
  userId       String?
  userName     String?
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([geoClientId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
